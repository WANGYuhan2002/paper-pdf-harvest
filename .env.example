# paper-pdf-harvest settings: variable names only, never real values.
# Copy this file to .env (git-ignored), or better put the keys in ~/.config/seismo_harvester/keys.env, outside every
# repository. Every key is optional: the open channels need none. Where to get each key, what it costs and what it
# unlocks: docs/KEYS.md (中文: docs/KEYS_zh.md). The names start with SEISMO_ because the engine comes from
# SeismoHub; one keys file serves both tools.

# User-Agent with your own contact address, e.g.  paper-pdf-harvest/1.0 (mailto:you@example.org)
# (puts you in Crossref's polite pool and raises DataCite's rate limit)
SEISMO_HARVEST_UA=

# Elsevier API key (DOI prefix 10.1016) and, optionally, an institutional token
ELSEVIER_API_KEY=
ELSEVIER_INSTTOKEN=

# Wiley TDM client token (DOI prefixes 10.1002, 10.1111, 10.1029 / AGU)
WILEY_TDM_TOKEN=

# OpenAlex API key (cached PDFs from content.openalex.org within the free daily allowance)
OPENALEX_API_KEY=

# Another env-style keys file to read, and the size cap per download in bytes (default 160 MB)
SEISMO_HARVEST_KEYS_FILE=
SEISMO_HARVEST_MAX_BYTES=
